+/-- The exact positive target is equivalent to saying that the finite collision
+cover is eventually not full at every positive logarithmic exponent. -/
+theorem erdos_1004_iff_eventually_collisionCoveredStarts_card_lt :
+    (True ↔ ∀ c > (0 : ℝ), ∀ᶠ x : ℕ in atTop, ∃ n ≤ x,
+      Erdos1004.IsDistinctTotientRun n (requestedRunLength x c)) ↔
+    (True ↔ ∀ c > (0 : ℝ), ∀ᶠ x : ℕ in atTop,
+      (collisionCoveredStarts x (requestedRunLength x c)).card < x + 1) := by
+  simp_rw [exists_isDistinctTotientRun_iff_collisionCoveredStarts_card_lt]
+
+/-- The exact negation of Erdős 1004 is equivalent to full collision coverage
+occurring frequently for one positive logarithmic exponent. -/
+theorem erdos_1004_false_iff_exists_frequently_collisionCover_full :
+    (¬(True ↔ ∀ d > (0 : ℝ), ∀ᶠ x : ℕ in atTop, ∃ n ≤ x,
+      Erdos1004.IsDistinctTotientRun n (requestedRunLength x d))) ↔
+    ∃ c > (0 : ℝ), ∃ᶠ x : ℕ in atTop,
+      (collisionCoveredStarts x (requestedRunLength x c)).card = x + 1 := by
+  simp only [true_iff,
+    exists_isDistinctTotientRun_iff_collisionCoveredStarts_card_lt,
+    not_forall, not_imp, not_eventually,
+    not_collisionCoveredStarts_card_lt_iff_eq]
+
+/-- Full collision coverage is exactly the local all-starts collision condition. -/
+theorem allStartsHaveCollision_iff_collisionCoveredStarts_card_eq (x K : ℕ) :
+    AllStartsHaveCollision x K ↔
+      (collisionCoveredStarts x K).card = x + 1 := by
+  rw [← no_distinct_run_iff_allStartsHaveCollision,
+    no_distinct_run_iff_collisionCoveredStarts_card_eq]
+
