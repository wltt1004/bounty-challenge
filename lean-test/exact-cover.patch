+/-- A desired run exists exactly when the collision cover does not fill all
+`x+1` candidate starts. -/
+theorem exists_isDistinctTotientRun_iff_collisionCoveredStarts_card_lt
+    (x K : ℕ) :
+    (∃ n ≤ x, Erdos1004.IsDistinctTotientRun n K) ↔
+      (collisionCoveredStarts x K).card < x + 1 := by
+  constructor
+  · rintro ⟨n, hn, hrun⟩
+    have hnmem : n ∈ distinctTotientRunStarts x K :=
+      mem_distinctTotientRunStarts.mpr ⟨hn, hrun⟩
+    have hpos : 0 < (distinctTotientRunStarts x K).card :=
+      Finset.card_pos.mpr ⟨n, hnmem⟩
+    rw [distinctTotientRunStarts_card_eq] at hpos
+    omega
+  · intro hcard
+    have hpos : 0 < (distinctTotientRunStarts x K).card := by
+      rw [distinctTotientRunStarts_card_eq]
+      omega
+    obtain ⟨n, hn⟩ := Finset.card_pos.mp hpos
+    rcases mem_distinctTotientRunStarts.mp hn with ⟨hnx, hrun⟩
+    exact ⟨n, hnx, hrun⟩
+
+/-- Every candidate run fails exactly when the collision cover has full
+cardinality `x+1`. -/
+theorem no_distinct_run_iff_collisionCoveredStarts_card_eq (x K : ℕ) :
+    (¬∃ n ≤ x, Erdos1004.IsDistinctTotientRun n K) ↔
+      (collisionCoveredStarts x K).card = x + 1 := by
+  have hle : (collisionCoveredStarts x K).card ≤ x + 1 := by
+    calc
+      (collisionCoveredStarts x K).card ≤ (candidateStarts x).card :=
+        Finset.card_le_card
+          (collisionCoveredStarts_subset_candidateStarts x K)
+      _ = x + 1 := card_candidateStarts x
+  rw [exists_isDistinctTotientRun_iff_collisionCoveredStarts_card_lt]
+  omega
+
+/-- The collision cover cannot have cardinality above the candidate set, so
+failure of the strict inequality is equivalent to full coverage. -/
+theorem not_collisionCoveredStarts_card_lt_iff_eq (x K : ℕ) :
+    (¬(collisionCoveredStarts x K).card < x + 1) ↔
+      (collisionCoveredStarts x K).card = x + 1 := by
+  have hle : (collisionCoveredStarts x K).card ≤ x + 1 := by
+    calc
+      (collisionCoveredStarts x K).card ≤ (candidateStarts x).card :=
+        Finset.card_le_card
+          (collisionCoveredStarts_subset_candidateStarts x K)
+      _ = x + 1 := card_candidateStarts x
+  omega
+
